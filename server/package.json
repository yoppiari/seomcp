{
  "name": "mcp-seo-server",
  "version": "1.0.0",
  "description": "MCP Server for Google Ads Keyword Planner Data Extraction",
  "main": "dist/index.js",
  "bin": {
    "mcp-seo-server": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "start:mcp": "node dist/mcp-server.js",
    "dev": "tsc && node dist/index.js",
    "dev:mcp": "tsc && node dist/mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-session": "^1.17.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
